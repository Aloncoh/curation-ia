# Copier ce fichier en .env.local (non versionné), puis y saisir les clés soi-même.
# Ne jamais mettre une vraie clé dans ce fichier.

# Comparaison des modèles (npm run comparaison) : les deux clés sont requises.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Facultatif : abaisse le plafond de la comparaison. Maximum accepté : 1.
# CURATION_PLAFOND_COMPARAISON_USD=1

# Lot de brouillons (npm run brouillons) : aucune valeur par défaut.
# CURATION_MODELE=claude-haiku-5-5
# CURATION_MAX_ACTUALITES=
# CURATION_PLAFOND_EXECUTION_USD=
# CURATION_PLAFOND_TOTAL_USD=
