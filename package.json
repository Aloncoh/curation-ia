{
  "name": "curation-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur de curation participative de l'IA : collecte sourcée, analyse et publication.",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "collect": "node src/cli/collect.ts",
    "status": "node src/cli/status.ts",
    "export": "node src/cli/export.ts",
    "brouillons": "node src/cli/brouillons.ts",
    "brouillons:relire": "node src/cli/brouillons-relire.ts",
    "maquette": "node src/cli/maquette.ts",
    "maquette:reel": "node src/cli/maquette-reel.ts",
    "pause": "node src/cli/pause.ts",
    "resume": "node src/cli/resume.ts",
    "db:migrate": "node src/cli/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sonde": "node src/cli/sonde.ts",
    "delais": "node src/cli/delais.ts",
    "selection": "node src/cli/selection.ts",
    "montage": "node src/cli/montage.ts",
    "budget": "node src/cli/budget.ts",
    "comparaison": "node src/cli/comparaison.ts",
    "cles": "node src/cli/cles.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/recursive": "5.3.0",
    "@libsql/client": "0.18.0",
    "@rowanmanning/feed-parser": "2.1.5",
    "drizzle-orm": "0.45.4",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
